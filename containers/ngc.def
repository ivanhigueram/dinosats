Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.9.2
Stage: uv

Bootstrap: docker
From: nvcr.io/nvidia/pytorch:26.02-py3
Stage: runtime

%files from uv
    /uv /usr/local/bin/uv

%files
    containers/ngc-requirements.txt /opt/dinosats/ngc-requirements.txt
    scripts/check_runtime.py /opt/dinosats/scripts/check_runtime.py
    scripts/build_siaya.py /opt/dinosats/scripts/build_siaya.py
    scripts/build_siaya_full.py /opt/dinosats/scripts/build_siaya_full.py
    scripts/siaya_io.py /opt/dinosats/scripts/siaya_io.py
    scripts/embed.py /opt/dinosats/scripts/embed.py
    scripts/dinotxt.py /opt/dinosats/scripts/dinotxt.py

%post
    set -eu
    python3 -c 'from importlib.metadata import version; print("\n".join(name + "==" + version(name) for name in ("torch", "torchvision")))' \
        > /opt/dinosats/ngc-torch-constraints.txt
    uv venv --python /usr/bin/python3 --system-site-packages /opt/venv
    uv pip install --python /opt/venv/bin/python --no-cache \
        --constraint /etc/pip/constraint.txt \
        --constraint /opt/dinosats/ngc-torch-constraints.txt \
        --requirement /opt/dinosats/ngc-requirements.txt
    /opt/venv/bin/python -c 'from importlib.metadata import version; print("\n".join(name + "==" + version(name) for name in ("torch", "torchvision")))' \
        > /opt/dinosats/installed-torch.txt
    cmp /opt/dinosats/ngc-torch-constraints.txt /opt/dinosats/installed-torch.txt
    git init /opt/dinosats/dinov3
    git -C /opt/dinosats/dinov3 remote add origin https://github.com/facebookresearch/dinov3.git
    git -C /opt/dinosats/dinov3 fetch --depth 1 origin 6876159a11b4df116f30f667f8c9888617df0751
    git -C /opt/dinosats/dinov3 checkout --detach FETCH_HEAD
    mkdir -p /opt/dinosats/weights
    uv pip freeze --python /opt/venv/bin/python > /opt/dinosats/runtime-packages.txt

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONNOUSERSITE=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONPATH=/opt/dinosats/scripts:/opt/dinosats/dinov3

%test
    python -c 'import numpy; assert numpy.__version__.startswith("1."), numpy.__version__'
    python /opt/dinosats/scripts/check_runtime.py

%runscript
    exec python -u /opt/dinosats/scripts/build_siaya_full.py "$@"

%labels
    org.opencontainers.image.title DinoSats Siaya embedding
    org.opencontainers.image.base.name nvcr.io/nvidia/pytorch:26.02-py3
    dinov3.commit 6876159a11b4df116f30f667f8c9888617df0751
